<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">

    <hostname>SW-NETCONF-DEMO</hostname>

    <vlan>
      <configuration>
        <vlan-id>10</vlan-id>
        <name>USERS</name>
      </configuration>
      <configuration>
        <vlan-id>20</vlan-id>
        <name>SERVERS</name>
      </configuration>
      <configuration>
        <vlan-id>30</vlan-id>
        <name>WIFI</name>
      </configuration>
      <configuration>
        <vlan-id>99</vlan-id>
        <name>MGMT</name>
      </configuration>
    </vlan>

    <interface>
      <GigabitEthernet>
        <name>1/0/1</name>
        <description>ACCESS PORT VLAN 10 - NETCONF DEMO</description>
        <switchport>
          <mode>
            <access/>
          </mode>
          <access>
            <vlan>
              <vlan>10</vlan>
            </vlan>
          </access>
        </switchport>
      </GigabitEthernet>

      <GigabitEthernet>
        <name>1/0/2</name>
        <description>ACCESS PORT VLAN 20 - NETCONF DEMO</description>
        <switchport>
          <mode>
            <access/>
          </mode>
          <access>
            <vlan>
              <vlan>20</vlan>
            </vlan>
          </access>
        </switchport>
      </GigabitEthernet>

      <GigabitEthernet>
        <name>1/0/24</name>
        <description>TRUNK PORT - NETCONF DEMO</description>
        <switchport>
          <mode>
            <trunk/>
          </mode>
          <trunk>
            <allowed>
              <vlan>
                <vlans>10,20,30,99</vlans>
              </vlan>
            </allowed>
          </trunk>
        </switchport>
      </GigabitEthernet>
    </interface>

  </native>
</config>